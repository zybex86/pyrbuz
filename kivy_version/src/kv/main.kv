<contents>
# Kivy language file for the main user interface layout of the game.

# Root widget of the application
<Game>:
    # Set the background color using a canvas instruction
    canvas.before:
        Color:
            rgba: 0.98, 0.94, 0.55, 1  # Light yellow background (matches BACKGROUND_COLOR)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        size: root.size
        pos: root.pos

        # Score at the top
        ScoreLabel:
            id: score_label
            size_hint_y: None
            height: 50

        # Main game area in the middle
        FloatLayout:
            id: game_area
            size_hint_y: 0.85

        # Restart button at the bottom
        AnchorLayout:
            size_hint_y: None
            height: 60
            anchor_x: "left"
            anchor_y: "bottom"
            Button:
                text: "Restart"
                size_hint: None, None
                size: 120, 40
                on_release: root.restart_game()

# Custom widget for displaying the score
<ScoreLabel>:
    text: root.score_text
    font_size: 32
    color: 0, 0, 0, 1  # Black text
    size_hint: 1, None
    height: 50
    canvas.before:
        PushMatrix
        Scale:
            origin: self.center
            x: self.anim_scale
            y: self.anim_scale
    canvas.after:
        PopMatrix
    

# You can define more custom widgets or layouts below as needed

# Example: Particle widget (if you want to style it in kv)
<Particle>:
    # The appearance of each fruit/particle can be customized here
    # For example, you could bind the color or image source
    # canvas:
    #     Color:
    #         rgba: 1, 0, 0, 1  # Example: red
    #     Ellipse:
    #         pos: self.pos
    #         size: self.size
</contents>